API_FOOTBALL_KEY=your_api_football_key_here
# URL base (debe empezar con https://). Si falta o es inválida, se usa el default de API-Sports.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku
NEXT_PUBLIC_DEFAULT_SEASON=2026
NEXT_PUBLIC_LEAGUE_ID=1

# Bot de Telegram (worker: npm run telegram:worker)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Tu chat id numérico (log al enviar /start si aún no lo tienes)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
